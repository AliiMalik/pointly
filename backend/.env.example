GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite     # fastest and 9/9 on the eval set (2026-10-14), see docs/DECISIONS.md
LLM_FALLBACK_MODEL=gemini-3.6-flash # used when LLM_MODEL is overloaded (503/429/5xx)
STT_MODEL=gemini-3.5-flash-lite     # same family, accepts audio input
LLM_THINKING=low                    # Gemini 3 thinking level: low | medium | high
GOOGLE_APPLICATION_CREDENTIALS=
TTS_MODEL=gemini-2.5-flash-tts      # Cloud Text-to-Speech Gemini-TTS model; ur-PK is a preview language
TTS_VOICE=Kore
REHNUMA_APP_KEY=change-me
LOG_DIR=./logs
LOG_SCREENS=false
# LLM_PROVIDER=mock                 # development only: keyword planner, no API key needed
